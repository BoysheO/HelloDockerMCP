{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ModelContextProtocol.Server.McpServer":"Warning"
    }
  },
  "OAuth": {
    "Enabled": true,
    "Issuer": "http://localhost:5001",
    "SigningKey": "dev-only-change-me-at-least-32-bytes",
    "Scope": "mcp",
    "ResourceName": "Hello Docker MCP"
  },
  "Storage": {
    "RootPath": "/storage"
  },
  "Skill": {
    "Path": "/skill/Skill.md"
  },
  "Git": {
    "DefaultTimeoutSeconds": 60,
    "MaxTimeoutSeconds": 300,
    "MaxOutputBytes": 131072
  },
  "Secret": {
    "AdminUsername": "admin",
    "AdminPassword": "change-this-secret-admin-password",
    "StorePath": "/secrets/secrets.json"
  },
  "Docker": {
    "TrustedRegistries": [
      "docker.io",
      "registry-1.docker.io",
      "mcr.microsoft.com"
      ],
    "ResourceLimits": {
      "MinMemoryMb": 64,
      "MaxMemoryMb": 1024,
      "MaxCpus": 2
    }
  }
}
