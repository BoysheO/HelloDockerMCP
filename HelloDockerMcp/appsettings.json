{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OAuth": {
    "Enabled": true,
    "Issuer": "http://localhost:5001",
    "SigningKey": "dev-only-change-me-at-least-32-bytes",
    "Scope": "mcp",
    "ResourceName": "Hello Docker MCP"
  },
  "Storage": {
    "RootPath": "/storage"
  },
  "Skill": {
    "Path": "/skill/Skill.md"
  },
  "Docker": {
    "TrustedRegistries": [
      "docker.io",
      "registry-1.docker.io"
          ],
    "ResourceLimits": {
      "MinMemoryMb": 64,
      "MaxMemoryMb": 1024,
      "MaxCpus": 2
    }
  }
}
