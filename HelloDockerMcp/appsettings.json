{
  "OAuth": {
    "Issuer": "http://localhost:5001",
    "SigningKey": "dev-only-change-me-at-least-32-bytes",
    "Scope": "mcp",
    "ResourceName": "Hello Docker MCP"
  },
  "Storage": {
    "RootPath": "/storage"
  },
  "Docker": {
    "AllowedImages": [
      "nginx",
      "redis",
      "python",
      "alpine",
      "hello-world",
      "ubuntu",
      "mcr.microsoft.com/dotnet/sdk"
    ],
    "ResourceLimits": {
      "MinMemoryMb": 64,
      "MaxMemoryMb": 1024,
      "MaxCpus": 2
    }
  }
}
